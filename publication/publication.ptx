<?xml version="1.0" encoding="UTF-8"?>
<!-- Publication settings for Intensive Analysis Prep.                      -->
<!-- Reference: https://pretextbook.org/doc/guide/html/publisher-file-reference.html -->
<!-- Settings not listed here use PreTeXt's defaults for a book.            -->

<publication>
  <common>
    <!-- One HTML page per section (each module component is a section). -->
    <chunking level="2" />
    <tableofcontents level="2" />
  </common>

  <source>
    <!-- Generated assets (if any) are written here, relative to source/main.ptx. -->
    <directories generated="../generated-assets" />
  </source>

  <numbering>
    <!-- Number chapters (modules) only; sections (the six components)  -->
    <!-- are unnumbered.  This replaces the post-build CSS injection the -->
    <!-- old pretextbook 0.8.3 builds used to hide section numbers.      -->
    <!-- Blocks are numbered within the chapter (1.1, 1.2, ...).         -->
    <!-- Inline exercises get their own counter (distinct="yes"), so      -->
    <!-- theorems, definitions and examples share one sequence and        -->
    <!-- exercises another.  Choice logged in decisions/structure.md.     -->
    <divisions level="1" />
    <exercises distinct="yes" />
  </numbering>

  <html>
    <!-- Proofs, examples and inline exercise statements display open,   -->
    <!-- not as click-to-open knowls.  Hints, answers and solutions (of  -->
    <!-- exercises and of examples) stay collapsible, hidden until       -->
    <!-- opened; example-solution keeps its default, "yes".              -->
    <knowl proof="no" example="no" exercise-inline="no" />
  </html>

</publication>
